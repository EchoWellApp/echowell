# EchoWell environment reference (TRD 21 §4.2, §4.3, §4.5, §4.6). Every variable, one comment each.
# Secrets are empty here. Local quick start: cp .env.development.example .env (never commit .env).
# --- Backend ---
APP_ENV=                       # local | staging | production | test
DATABASE_URL=                  # secret: app role echowell_app; sslmode=require in staging/production
DATABASE_MIGRATION_URL=        # secret: migrator role; Alembic and the operator CLI only (default DATABASE_URL)
DATABASE_READONLY_URL=         # secret: readonly role; required when PIPELINE_PROFILE=test_v0_1; empty in production
JWT_SECRET=                    # secret: >= 32 bytes, openssl rand -hex 32, different per environment
JWT_EXPIRES_MINUTES=60         # access token lifetime, 5-1440
CORS_ORIGINS=                  # comma-separated origins without path; required in staging/production
CORS_ORIGIN_REGEX=             # staging deploy previews only; must be empty in production
FACILITY_NAME=Edgewood         # used by bootstrap/seed to create the facilities row
FACILITY_TZ=America/Chicago    # IANA time zone of the facility
PIPELINE_PROFILE=production    # production | test_v0_1 (test_v0_1 refused in production)
PIPELINE_AS_OF=                # fixed as-of, ISO 8601 with offset; local/staging/test only
NIGHTLY_RUN_HOUR_LOCAL=2       # facility-local hour of the nightly run, 0-23
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                # json | console (console refused in staging/production)
SENTRY_DSN=                    # optional secret; empty disables Sentry
RATE_LIMIT_LOGIN=5/minute      # login limit per client IP; must be 5/minute in staging/production
RATE_LIMIT_INGEST=600/minute   # ingest limit per API key
GIT_SHA=unknown                # deployed commit, reported as version by /api/v1/health
DATA_SOURCE_LABEL=pipeline test data v0.1  # header text "Showing <label> as of ..."
SEED_ADMIN_PASSWORD=           # secret: seed test_v0_1 only (local, test, staging); refused in production
SEED_CLINICIAN_PASSWORD=       # secret: seed test_v0_1 only; refused in production
SEED_RESEARCHER_PASSWORD=      # secret: seed test_v0_1 only; refused in production
SEED_INGEST_API_KEY=           # secret: seed test_v0_1 only, >= 32 characters; refused in production
PORT=8000                      # listening port; injected by Railway/App Runner
# --- Frontend (public, inlined at build time; never a secret) ---
NEXT_PUBLIC_API_BASE_URL=      # backend origin only, no path (the client appends /api/v1)
NEXT_PUBLIC_APP_ENV=           # local | staging | production
NEXT_TELEMETRY_DISABLED=1      # disable Next.js telemetry
# --- Compose and CI database provisioning (local/CI only; never in staging or production) ---
POSTGRES_USER=                 # superuser of the Compose db / CI service container
POSTGRES_PASSWORD=             # local-dev-only-* / ci-only-* placeholder
POSTGRES_DB=                   # echowell (Compose) / echowell_test (CI)
ECHOWELL_MIGRATOR_DB_PASSWORD= # login-role passwords read by database/roles/provision_login_roles.sql
ECHOWELL_APP_DB_PASSWORD=
ECHOWELL_READONLY_DB_PASSWORD=
