{
  "name": "echowell-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:readonly": "playwright test --grep-invert \"@isolated|@mutating\"",
    "test:e2e:mutating": "playwright test --grep @mutating --workers=1",
    "test:e2e:isolated": "playwright test -c playwright.isolated.config.ts --project=chromium --workers=1",
    "gen:api": "openapi-typescript ../docs/api_reference/openapi.json -o lib/api-types.ts",
    "fixtures:capture": "node tests/fixtures/capture.mjs",
    "test:tz": "TZ=Pacific/Kiritimati vitest run tests/unit/format.test.ts --coverage.enabled=false && TZ=America/Los_Angeles vitest run tests/unit/format.test.ts --coverage.enabled=false",
    "check:bundle": "node ../scripts/ci/check-bundle.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@netlify/plugin-nextjs": "^5.16.6",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "25.0.1",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
