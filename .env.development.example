# Local development (docker compose). Copy to .env. Local-only values; never reuse elsewhere.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://echowell_app_login:local-dev-only-app@db:5432/echowell                 # app role, never the superuser
DATABASE_MIGRATION_URL=postgresql+psycopg://echowell_migrator_login:local-dev-only-migrator@db:5432/echowell
DATABASE_READONLY_URL=postgresql+psycopg://echowell_readonly_login:local-dev-only-readonly@db:5432/echowell
JWT_SECRET=local-dev-only-0123456789abcdef0123456789abcdef
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FACILITY_NAME=Edgewood
FACILITY_TZ=America/Chicago
PIPELINE_PROFILE=test_v0_1
PIPELINE_AS_OF=2026-10-30T15:00:00-05:00
SEED_ADMIN_PASSWORD=local-dev-only-change-me                  # placeholder (ENV-041); never valid in staging/production
SEED_CLINICIAN_PASSWORD=local-dev-only-change-me
SEED_RESEARCHER_PASSWORD=local-dev-only-change-me
SEED_INGEST_API_KEY=ewk_local-dev-only-change-me-change-me
NIGHTLY_RUN_HOUR_LOCAL=2
LOG_LEVEL=INFO
LOG_FORMAT=console
SENTRY_DSN=
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_INGEST=600/minute
GIT_SHA=unknown
DATA_SOURCE_LABEL=pipeline test data v0.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=local
NEXT_TELEMETRY_DISABLED=1
